{
  "manifest_version": 3,
  "name": "Nozian Search Toolkit + Media Bias PRISM",
  "version": "3.1.0",
  "description": "Google Cleanerと横断検索を維持、PRISMはAI入力欄へ自動挿入（送信なし）",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_title": "Search Toolkit / Media Bias PRISM",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*"
      ],
      "js": [
        "sync-settings.js",
        "legacy-google/content.js"
      ],
      "css": [
        "legacy-google/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*"
      ],
      "js": [
        "search-page.js"
      ],
      "css": [
        "search-page.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "legacy-ai/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*",
        "https://news.google.com/*",
        "https://news.yahoo.co.jp/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www3.nhk.or.jp/*",
        "https://www.nhk.or.jp/*",
        "https://*.asahi.com/*",
        "https://*.mainichi.jp/*",
        "https://*.yomiuri.co.jp/*",
        "https://*.nikkei.com/*",
        "https://*.sankei.com/*",
        "https://*.jiji.com/*",
        "https://*.reuters.com/*",
        "https://*.bbc.com/*",
        "https://*.huffingtonpost.jp/*",
        "https://*.tokyo-np.co.jp/*",
        "https://*.47news.jp/*",
        "https://*.newsweekjapan.jp/*",
        "https://*.forbesjapan.com/*",
        "https://*.bunshun.jp/*",
        "https://*.president.jp/*"
      ],
      "js": [
        "prism/prompts.js",
        "prism/injector.js"
      ],
      "css": [
        "prism/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
